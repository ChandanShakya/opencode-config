{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      },
      "brave-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "brave-mcp@1.10.1",
          "--executablePath",
          "/usr/bin/brave-origin"
        ]
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      }
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp",
    "oh-my-opencode-slim",
    "opencode-agent-memory",
    "github:obra/superpowers#bb92a77741419a4ab5f06e711a283343f1ada0c3",
    "./plugins/caveman"
  ],
  "formatter": true,
  "compaction": {
    "auto": true
  }
}
